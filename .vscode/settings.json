{
  "files.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/storage/framework/cache": true,
    "**/storage/framework/sessions": true,
    "**/storage/framework/views": true,
    "**/storage/logs": true,
    "**/.phpunit.cache": true
  },
  "search.exclude": {
    "**/vendor": true,
    "**/storage/framework/views": true,
    "**/storage/logs": true,
    "**/.phpunit.cache": true
  },
  "files.associations": {
    "*.blade.php": "blade"
  },
  "editor.rulers": [120],
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "php.suggest.basic": true,
  "workbench.startupEditor": "none"
}